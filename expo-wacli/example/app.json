{
  "expo": {
    "name": "wacli demo",
    "slug": "expo-wacli-example",
    "version": "1.0.0",
    "scheme": "wacli-example",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.wacli.example",
      "supportsTablet": true
    },
    "android": {
      "package": "com.wacli.example"
    },
    "plugins": [
      [
        "expo-wacli",
        {
          "abiFilters": ["arm64-v8a", "x86_64"]
        }
      ]
    ]
  }
}
