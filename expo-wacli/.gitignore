# gomobile output. Built by scripts/build-bindings.sh, never committed: the AAR carries a copy of
# the Go runtime per Android ABI and the XCFramework one per Apple architecture, which is around
# 100 MB of build artifact between them.
android/libs/*.aar
ios/Frameworks/

# Not committed: expo-wacli is published as a library, and the workspace root is that library, so
# consumers resolve their own tree. package.json pins tightly enough (~56.x, exact react and
# react-native) that a 376 KB generated file buys little.
bun.lock
bun.lockb

